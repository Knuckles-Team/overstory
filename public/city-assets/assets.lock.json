  "sources": {
    "robot-expressive": {
      "repo": "mrdoob/three.js",
      "url": "https://github.com/mrdoob/three.js",
      "tag": "r186",
      "commit": "9b4a2ac29c63ccb43fd51c5661f2f873ac2c39b8",
      "path": "examples/models/gltf/RobotExpressive/RobotExpressive.glb",
      "license": "CC0-1.0",
      "note": "The shared humanoid rig every city character is built on (OVERSTORY-CITY-R033, per OVERSTORY-DESIGN-R012.4): model by Tom\u00e1s Laulh\u00e9, modifications by Don McCurdy (facial morph targets, material cleanup), CC0 1.0 per the folder's README. Pinned at the exact commit of tag r186 \u2014 the same three major the repository runs. Attribution: public/city-assets/SOURCES.md."
    },
    "marker-cube": {
      "collection": "https://huggingface.co/collections/cfahlgren1/3d-datasets-in-the-dataset-viewer",
      "repo": "joshuasundance/throttlebrawl-assets",
      "url": "https://huggingface.co/datasets/joshuasundance/throttlebrawl-assets",
      "commit": "cf7ac1f31de6235d9033ffcece98e055e2a14535",
      "license": "MIT",
      "note": "The placeholder marker cube (construction markers, reserved-plot markers). The rest of this pack's rider characters left the city with the 2026-11-19 shared-rig cast (OVERSTORY-CITY-R033); the cube is the only file kept. The pack's OSM/USGS terrain JSONs (ODbL 1.0) were never copied; the city generates its road network instead. Attribution: public/city-assets/SOURCES.md."
    },
    "city-kit": {
      "repo": "Knuckles-Team/overstory",
      "url": "https://github.com/Knuckles-Team/overstory",
      "branch": "spec/city-procedural-asset-pack",
      "path": "public/city-assets/kit/",
      "license": "CC0-1.0",
      "note": "Original city asset kit: 98 families across eight categories, authored in Blender through the blender-mcp pipeline (scripts/asset-kit/), per specs/arbora-city/asset-pack.md launch catalog and authoring protocol (R048.1/R048.2/R048.4). No external sources: flat palette materials, no textures. Per-family export QA reports and multi-angle review renders are recorded in the delivery PR."
    }
  },
